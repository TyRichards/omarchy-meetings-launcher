#!/usr/bin/env python3
"""Launch one validated HTTPS URL without exposing it in process arguments.

The canonical URL arrives only on stdin. A private, short-lived redirect document
bridges Chromium's argv-only --app interface: omarchy-launch-webapp receives only
a non-secret file URL, while the meeting URL stays in an owner-only runtime file.
The file is removed as soon as Chromium opens it (or after a short deadline).
"""

import html
import os
from pathlib import Path
import shutil
import stat
import subprocess
import sys
import tempfile
import time
from urllib.parse import urlsplit

MAX_URL_BYTES = 16384
MAX_URL_LENGTH = 4096
ACCESS_TIMEOUT_SECONDS = 10


def fail(message):
    print(f"meetings-launch: {message}", file=sys.stderr)
    raise SystemExit(2)


def read_validated_url():
    data = sys.stdin.buffer.read(MAX_URL_BYTES + 1)
    if not data or len(data) > MAX_URL_BYTES:
        fail("expected one bounded HTTPS URL on stdin")
    try:
        url = data.decode("utf-8")
    except UnicodeDecodeError:
        fail("URL is not valid UTF-8")

    if len(url) > MAX_URL_LENGTH or any(ord(character) < 0x20 or ord(character) == 0x7F for character in url):
        fail("URL contains invalid characters")

    try:
        parsed = urlsplit(url)
        hostname = parsed.hostname
        port = parsed.port
    except ValueError:
        fail("URL is malformed")

    # Panel.qml sends Model.launchUrl's already-canonical value. Recheck the
    # security boundary here so direct helper invocation cannot launch a
    # plaintext, userinfo-bearing, or authority-confused URL.
    canonical_authority = ""
    if hostname is not None:
        canonical_authority = f"[{hostname}]" if ":" in hostname else hostname
        if port is not None:
            canonical_authority += f":{port}"
    if (
        parsed.scheme != "https"
        or not parsed.netloc
        or hostname is None
        or parsed.username is not None
        or parsed.password is not None
        or "@" in parsed.netloc
        or "\\" in url
        or hostname.endswith(".")
        or port == 443
        or parsed.netloc != canonical_authority
    ):
        fail("URL must be a canonical HTTPS URL without userinfo")

    return url


def private_runtime_directory():
    runtime = os.environ.get("XDG_RUNTIME_DIR", "")
    if not runtime or not os.path.isabs(runtime):
        fail("XDG_RUNTIME_DIR is unavailable")
    try:
        info = os.lstat(runtime)
    except OSError:
        fail("XDG_RUNTIME_DIR is unavailable")
    if (
        not stat.S_ISDIR(info.st_mode)
        or stat.S_ISLNK(info.st_mode)
        or info.st_uid != os.getuid()
        or stat.S_IMODE(info.st_mode) & 0o077
    ):
        fail("XDG_RUNTIME_DIR is not private")
    return runtime


def write_redirect(directory, url):
    path = Path(directory) / "launch.html"
    document = (
        "<!doctype html><meta charset=\"utf-8\">"
        "<meta name=\"referrer\" content=\"no-referrer\">"
        "<meta http-equiv=\"refresh\" content=\"0;url="
        + html.escape(url, quote=True)
        + "\"><title>Opening meeting…</title>"
    ).encode("utf-8")

    fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
    try:
        view = memoryview(document)
        while view:
            written = os.write(fd, view)
            if written <= 0:
                raise OSError("write made no progress")
            view = view[written:]
        os.fsync(fd)
    finally:
        os.close(fd)
    return path


def wait_until_opened(path, launcher):
    initial_atime = path.stat().st_atime_ns
    deadline = time.monotonic() + ACCESS_TIMEOUT_SECONDS
    while time.monotonic() < deadline:
        try:
            if path.stat().st_atime_ns != initial_atime:
                return
        except FileNotFoundError:
            return
        code = launcher.poll()
        if code not in (None, 0):
            fail("web-app launcher failed")
        time.sleep(0.05)


def launch(url):
    runtime = private_runtime_directory()
    directory = tempfile.mkdtemp(prefix="omarchy-meetings-", dir=runtime)
    os.chmod(directory, 0o700)
    try:
        path = write_redirect(directory, url)
        try:
            launcher = subprocess.Popen(
                ["omarchy-launch-webapp", path.as_uri()],
                stdin=subprocess.DEVNULL,
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                close_fds=True,
            )
        except OSError:
            fail("web-app launcher is unavailable")
        wait_until_opened(path, launcher)
    finally:
        shutil.rmtree(directory, ignore_errors=True)


def main():
    if len(sys.argv) != 1:
        fail("this helper accepts the URL on stdin only")
    try:
        launch(read_validated_url())
    except OSError:
        fail("meeting could not be launched safely")


if __name__ == "__main__":
    main()
