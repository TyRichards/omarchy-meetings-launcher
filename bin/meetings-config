#!/usr/bin/env python3
"""Secure, bounded, descriptor-relative I/O for meetings.json.

All leaf operations use a retained directory descriptor. Reads refuse symlinks,
non-regular files, files owned by another user, permissive modes, and content
larger than 64 KiB. Writes use an exclusive random 0600 temporary, fsync it,
rename it atomically, and fsync the directory.
"""

import os
import secrets
import stat
import sys

MAX_CONFIG_BYTES = 65536
_DIR_FLAGS = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW


def fail(message):
    print(f"meetings-config: {message}", file=sys.stderr)
    raise SystemExit(2)


def write_all(fd, data):
    view = memoryview(data)
    while view:
        written = os.write(fd, view)
        if written <= 0:
            raise OSError("write made no progress")
        view = view[written:]


def open_config_dir(path):
    """Open every absolute path component without following symlinks."""
    directory = os.path.abspath(os.path.dirname(path))
    parts = [part for part in directory.split("/") if part]
    current = os.open("/", _DIR_FLAGS)
    try:
        for index, part in enumerate(parts):
            is_last = index == len(parts) - 1
            try:
                child = os.open(part, _DIR_FLAGS, dir_fd=current)
            except FileNotFoundError:
                if not is_last:
                    raise
                os.mkdir(part, 0o700, dir_fd=current)
                child = os.open(part, _DIR_FLAGS, dir_fd=current)
            os.close(current)
            current = child

        info = os.fstat(current)
        if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid():
            fail("config directory must be an owned directory")
        if info.st_mode & 0o022:
            fail("config directory must not be writable by group or others")
        return current
    except BaseException:
        os.close(current)
        raise


def inspect_existing(dfd, leaf):
    try:
        info = os.stat(leaf, dir_fd=dfd, follow_symlinks=False)
    except FileNotFoundError:
        return None
    if not stat.S_ISREG(info.st_mode):
        fail("config path is not a regular file")
    if info.st_uid != os.getuid():
        fail("config file is not owned by the current user")
    return info


def cmd_setup(path):
    leaf = os.path.basename(path)
    dfd = open_config_dir(path)
    try:
        info = inspect_existing(dfd, leaf)
        if info is not None and stat.S_IMODE(info.st_mode) != 0o600:
            os.chmod(leaf, 0o600, dir_fd=dfd, follow_symlinks=False)
    finally:
        os.close(dfd)


def cmd_read(path):
    leaf = os.path.basename(path)
    dfd = open_config_dir(path)
    try:
        try:
            fd = os.open(
                leaf,
                os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK,
                dir_fd=dfd,
            )
        except FileNotFoundError:
            raise SystemExit(1)
        try:
            info = os.fstat(fd)
            if not stat.S_ISREG(info.st_mode):
                fail("config is not a regular file")
            if info.st_uid != os.getuid():
                fail("config is not owned by the current user")
            if stat.S_IMODE(info.st_mode) != 0o600:
                fail("config permissions must be 0600")
            if info.st_size > MAX_CONFIG_BYTES:
                fail(f"config exceeds {MAX_CONFIG_BYTES} bytes")

            chunks = []
            size = 0
            while size <= MAX_CONFIG_BYTES:
                chunk = os.read(fd, min(16384, MAX_CONFIG_BYTES + 1 - size))
                if not chunk:
                    break
                chunks.append(chunk)
                size += len(chunk)
            if size > MAX_CONFIG_BYTES:
                fail(f"config exceeds {MAX_CONFIG_BYTES} bytes")
            write_all(sys.stdout.fileno(), b"".join(chunks))
        finally:
            os.close(fd)
    finally:
        os.close(dfd)


def cmd_write(path):
    leaf = os.path.basename(path)
    dfd = open_config_dir(path)
    temp_name = None
    temp_fd = -1
    try:
        inspect_existing(dfd, leaf)
        data = sys.stdin.buffer.read(MAX_CONFIG_BYTES + 1)
        if not data:
            fail("refusing to write an empty config")
        if len(data) > MAX_CONFIG_BYTES:
            fail(f"refusing to write more than {MAX_CONFIG_BYTES} bytes")

        for _ in range(8):
            candidate = f".meetings.{secrets.token_hex(12)}"
            try:
                temp_fd = os.open(
                    candidate,
                    os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
                    0o600,
                    dir_fd=dfd,
                )
                temp_name = candidate
                break
            except FileExistsError:
                continue
        if temp_fd < 0:
            fail("could not create a private temporary file")

        write_all(temp_fd, data)
        os.fchmod(temp_fd, 0o600)
        os.fsync(temp_fd)
        os.close(temp_fd)
        temp_fd = -1
        os.rename(temp_name, leaf, src_dir_fd=dfd, dst_dir_fd=dfd)
        temp_name = None
        os.fsync(dfd)
    finally:
        if temp_fd >= 0:
            try:
                os.close(temp_fd)
            except OSError:
                pass
        if temp_name is not None:
            try:
                os.unlink(temp_name, dir_fd=dfd)
            except OSError:
                pass
        os.close(dfd)


def main():
    if len(sys.argv) != 3:
        fail("usage: meetings-config <setup|read|write> <path>")
    action, path = sys.argv[1], sys.argv[2]
    if not os.path.isabs(path) or os.path.basename(path) in ("", ".", ".."):
        fail("config path must be an absolute file path")
    try:
        if action == "setup":
            cmd_setup(path)
        elif action == "read":
            cmd_read(path)
        elif action == "write":
            cmd_write(path)
        else:
            fail("unknown action")
    except OSError as error:
        fail(f"unsafe config path: {error}")


if __name__ == "__main__":
    main()
